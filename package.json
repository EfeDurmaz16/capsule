{
  "name": "capsule",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm clean:build && pnpm -r build && pnpm prune:build",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:package-exports": "vitest run packages/core/src/package-exports.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "clean:build": "node scripts/clean-build-artifacts.mjs",
    "prune:build": "node scripts/prune-package-artifacts.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm typecheck && pnpm test && pnpm build && pnpm release:audit && changeset publish",
    "release:audit": "pnpm release:metadata-audit && pnpm release:dependency-audit && pnpm release:markers && pnpm release:pack-smoke",
    "release:metadata-audit": "node scripts/package-publish-audit.mjs --dry-run",
    "release:dependency-audit": "node scripts/dependency-license-audit.mjs",
    "release:markers": "node scripts/no-unfinished-markers.mjs",
    "release:pack-smoke": "node scripts/package-pack-smoke.mjs",
    "release:pack-smoke:compatible": "node scripts/package-pack-smoke.mjs --respect-engines",
    "release:provenance": "node scripts/verify-published-provenance.mjs --dry-run",
    "docs:api": "node scripts/generate-api-reference.mjs",
    "capsule:gap": "node scripts/capsule-gap-report.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
