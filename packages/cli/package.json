{
  "name": "@capsule-sdk/cli",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "capsule": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capsule-sdk/adapter-azure-container-apps": "workspace:*",
    "@capsule-sdk/adapter-cloudflare": "workspace:*",
    "@capsule-sdk/adapter-cloud-run": "workspace:*",
    "@capsule-sdk/adapter-daytona": "workspace:*",
    "@capsule-sdk/adapter-docker": "workspace:*",
    "@capsule-sdk/adapter-e2b": "workspace:*",
    "@capsule-sdk/adapter-ec2": "workspace:*",
    "@capsule-sdk/adapter-ecs": "workspace:*",
    "@capsule-sdk/adapter-fly": "workspace:*",
    "@capsule-sdk/adapter-kubernetes": "workspace:*",
    "@capsule-sdk/adapter-lambda": "workspace:*",
    "@capsule-sdk/adapter-mock": "workspace:*",
    "@capsule-sdk/adapter-modal": "workspace:*",
    "@capsule-sdk/adapter-neon": "workspace:*",
    "@capsule-sdk/adapter-vercel": "workspace:*",
    "@capsule-sdk/core": "workspace:*",
    "@capsule-sdk/presets": "workspace:*",
    "@capsule-sdk/preview": "workspace:*",
    "@capsule-sdk/store-jsonl": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "description": "Capsule command line: doctor, capabilities, policy explain, receipts, presets, preview lifecycle, and provider-backed runs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EfeDurmaz16/capsule.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/EfeDurmaz16/capsule#readme",
  "bugs": {
    "url": "https://github.com/EfeDurmaz16/capsule/issues"
  },
  "keywords": [
    "capsule",
    "cli",
    "runtime",
    "deployment",
    "sandboxes"
  ],
  "engines": {
    "node": ">=22"
  }
}
